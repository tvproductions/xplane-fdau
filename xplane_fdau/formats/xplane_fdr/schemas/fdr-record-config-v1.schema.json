{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tvproductions.github.io/xplane-fdau/schemas/fdr-record-config-v1.schema.json",
  "title": "xplane-fdau native X-Plane FDR recording configuration version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "^[^\\u0000]*$"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["minimal", "standard", "systems", "avionics", "full"]
      },
      "default": ["standard"]
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.1
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aircraft_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$(?![\\s\\S])"
        },
        "tail_number": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$(?![\\s\\S])"
        },
        "local_date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
        },
        "pressure_in_hg": {
          "type": "number"
        },
        "isa_offset_c": {
          "type": "number"
        },
        "wind_direction_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "wind_speed_kt": {
          "type": "number",
          "minimum": 0
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000\\r\\n]*$(?![\\s\\S])"
          }
        }
      }
    },
    "datarefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000\\r\\n]+$(?![\\s\\S])"
          },
          "scale": {
            "type": "number"
          },
          "comment": {
            "type": "string",
            "pattern": "^[^\\u0000\\r\\n]*$(?![\\s\\S])"
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$",
          "default": "Output/FDR files"
        },
        "filename": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)[^/\\\\\\u0000\\r\\n]*\\.fdr$(?![\\s\\S])"
        }
      }
    }
  }
}
